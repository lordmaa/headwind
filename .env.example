# ── Login (optional — blank = Headwind generates a random key/password on first start; see README) ──
# Generate a random string: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Login credentials for the web UI
APP_USERNAME=admin
APP_PASSWORD=

# Your instance's own URL (used in notification links and the phone app's QR pairing code).
APP_URL=http://localhost:5001

# ── AI coaching (optional) ───────────────────────────────────────
# Configured inside the app (Settings → AI): an OpenAI-compatible API key, or a local Ollama URL + model. Nothing to set here.

# ── Telemetry (optional) ─────────────────────────────────────────
# A single, one-time, anonymous ping on first setup (random install id + version only — see the setup
# wizard's telemetry step for exactly what's sent). Already asks in the wizard with a permanent opt-out;
# set this if you'd rather skip that question entirely and never send it.
# TELEMETRY=off

# ── Notes ────────────────────────────────────────────────────────
# First run takes you through a setup wizard: name your rider(s), pick units, optionally connect Garmin
# (MFA-capable, no CLI needed) and Home Assistant. Strava's public API was locked down by Strava in 2025 and
# is no longer usable for live sync — a Strava data-export zip can still be imported as a one-off (see /import).
# MQTT and Garmin credentials are configured inside the app (Settings page), not here.
